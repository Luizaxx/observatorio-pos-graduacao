# Copie para .env:  cp .env.example .env
POSTGRES_USER=obs
POSTGRES_PASSWORD=obs

AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=admin
# No Linux, rode `id -u` e coloque o resultado aqui (evita problema de permissão em logs/ e data/)
AIRFLOW_UID=50000

# Datasets no portal de dados abertos da CAPES (API CKAN)
CAPES_DATASET_PROGRAMAS=2021-a-2024-programas-da-pos-graduacao-stricto-sensu-no-brasil
CAPES_DATASET_DISCENTES=2021-a-2024-discentes-da-pos-graduacao-stricto-sensu-do-brasil
CAPES_DATASET_TESES=2021-a-2024-catalogo-de-teses-e-dissertacoes-brasil
